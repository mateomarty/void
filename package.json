{
  "name": "void-messenger",
  "version": "0.4.0",
  "private": true,
  "description": "Peer-to-peer messenger in a single HTML file: no server, no account, no install",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mateomarty/void.git"
  },
  "homepage": "https://github.com/mateomarty/void",
  "keywords": [
    "p2p",
    "messenger",
    "webrtc",
    "end-to-end-encryption",
    "friend-to-friend",
    "serverless",
    "post-quantum"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "notices": "node scripts/notices.mjs",
    "test": "node --test --test-timeout=60000 test/unit/",
    "test:browser": "node test/browser/run.mjs",
    "test:interop": "node test/browser/interop.mjs",
    "check": "npm run build && npm test && npm run test:browser"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@hpke/chacha20poly1305": "^1.8.1",
    "@hpke/core": "^1.10.1",
    "@hpke/dhkem-x448": "^1.8.1",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1"
  }
}
